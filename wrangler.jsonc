{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "analytics",
  "main": "python_backend/main.py",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "python_workers",
    "disable_python_external_sdk"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
